# Build stage
FROM node:18-alpine as build

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install

# Copy application code
COPY . .

# Build the client
RUN npm run build

# Debug: List the contents to see where the build output is
RUN ls -la && ls -la dist || echo "dist directory not found, checking other locations" && ls -la src/client || echo "checking root" && ls -la /app

# Production stage
FROM nginx:alpine

# Copy the built files from the build stage - use a more flexible approach
# Try multiple possible build output locations
COPY --from=build /app/dist /usr/share/nginx/html/ || true
COPY --from=build /app/build /usr/share/nginx/html/ || true

# Copy nginx configuration
COPY nginx-client.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]


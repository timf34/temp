FROM nginx:alpine

WORKDIR /app

# Copy the client source files directly
COPY src/client /usr/share/nginx/html/
COPY src/client/index.html /usr/share/nginx/html/index.html

# Copy required assets
COPY src/client/index.css /usr/share/nginx/html/index.css

# Copy nginx configuration
COPY nginx-client.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

